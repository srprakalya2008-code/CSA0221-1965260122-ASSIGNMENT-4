#include <stdio.h>
#include <stdlib.h>

enum kind { TEMPERATURE, HUMIDITY, STATUS };

struct packet {
    enum kind type;
    void *data;
};

int main(void)
{
    struct packet p;
    p.type = TEMPERATURE;
    p.data = malloc(sizeof(float));

    if (p.data == NULL)
        return 1;

    *(float *)p.data = 31.5f;
    printf("Temperature = %.1f C\n", *(float *)p.data);

    free(p.data);
    return 0;
}


